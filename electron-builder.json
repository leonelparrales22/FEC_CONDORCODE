{
  "appId": "com.fec.condorcode",
  "productName": "FEC_CONDORCODE",
  "directories": {
    "output": "dist"
  },
  "files": [
    "apps/main/**/*",
    "apps/renderer/**/*",
    "src/**/*",
    "public/**/*"
  ],
  "win": {
    "target": ["nsis", "msi"]
  },
  "mac": {
    "target": ["dmg", "pkg"]
  },
  "linux": {
    "target": ["deb", "AppImage"]
  }
}
